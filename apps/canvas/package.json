{
  "name": "idml-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "bash build-wasm.sh",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:fidelity": "playwright test --config=playwright.config.ts",
    "test:fidelity:capture": "FIDELITY_MODE=capture playwright test --config=playwright.config.ts",
    "test:fidelity:ui": "playwright test --config=playwright.config.ts --ui",
    "test:fidelity:dashboard": "open ${FIDELITY_OUT:-/tmp/idml-canvas-fidelity}/dashboard.html",
    "test:fidelity:report": "playwright show-report",
    "fonts:list": "tsx scripts/fonts-resolve.ts --list",
    "fonts:resolve": "tsx scripts/fonts-resolve.ts"
  },
  "dependencies": {
    "@verso/catalog": "workspace:*",
    "@verso/client": "workspace:*",
    "@verso/shell": "workspace:*",
    "@verso/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
