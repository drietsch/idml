target/
**/*.rs.bk
Cargo.lock

# WASM build output
pkg/
node_modules/

# Fidelity artefacts (generated locally)
corpus/**/out/
corpus/**/diff/
*.actual.png

# InDesign lock files (created next to a .indd while it's open in
# the GUI; harmless to delete when the app isn't running).
*.idlk
~*

# External sample downloads + paired references (see corpus/samples/README.md).
# Licensing on third-party samples is unconfirmed; never commit them.
corpus/samples/customerscanvas/
corpus/samples/*.idml
corpus/samples/*.pdf
# Exception: the hand-authored manual-sample.* (originally created in
# this repo by the project author for renderer regression testing) is
# tracked. Add other tracked samples here on a case-by-case basis.
!corpus/samples/manual-sample.idml
!corpus/samples/manual-sample.indd
!corpus/samples/manual-sample.pdf
!corpus/samples/manual-sample.export.meta.json

# Adobe-copyrighted reference material kept locally only.
idml-specification.pdf

# Envato pack corpus: zips + unpacked artefacts are large + carry
# their own licensing terms (preview-and-render only). Track only the
# harness scripts, the manifest, overrides, and the README.
corpus/envato/*.zip
corpus/envato/packs/
corpus/envato/reports/

# Editor/OS
.DS_Store
.vscode/
.idea/
